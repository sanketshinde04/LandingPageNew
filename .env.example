# ---------------------------------------------------------------------------
# Booking — /api/booking writes straight into Google Calendar and sends the
# invite. Without all three of these the CTA falls back to a mailto, so the
# button is never dead.
#
# Create an OAuth client (type: Web application) at console.cloud.google.com,
# enable the Google Calendar API, then run the consent flow once with
# scope https://www.googleapis.com/auth/calendar and access_type=offline
# to get a refresh token.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Which calendar to write to. "primary" is the calendar of the account that
# granted consent; otherwise paste a calendar ID from Calendar settings.
BOOKING_CALENDAR_ID=primary
